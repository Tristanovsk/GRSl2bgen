flowchart LR
    subgraph main["Input Main data"]
        IN1["GRS Level-2A product (Rrs)<br/>NetCDF / Zarr, or dir + _anc.nc<br/>Disk/POSIX"]
    end

    PROC["GRSl2bgen Processing Chain<br/>GRSl2bgen CLI / GRSl2bgen.process.Process"]
    MASK["Water mask<br/>(L2A mask == 0)"]

    subgraph steps["Water quality retrievals"]
        S1["OWT classification (SAM)<br/>(Spyrakos2018, Bi2024, Tarasenko2025)"]
        S2["Chlorophyll-a<br/>(incl. OWT-blended)"]
        S3["SPM and turbidity"]
        S4["CDOM"]
        S5["Transparency (Kd PAR)"]
    end

    subgraph out["Output Data"]
        OUT1["Level-2B water quality product<br/>NetCDF or Zarr (optional pyramid)<br/>Disk/POSIX"]
    end

    IN1 --> PROC
    PROC --> MASK
    MASK --> S1
    MASK --> S2
    MASK --> S3
    MASK --> S4
    MASK --> S5
    S1 -. "Spyrakos2018 top classes" .-> S2
    S1 --> OUT1
    S2 --> OUT1
    S3 --> OUT1
    S4 --> OUT1
    S5 --> OUT1

    classDef mainStyle fill:#3d85c6,stroke:#1c4587,stroke-width:2px,color:#ffffff
    classDef procStyle fill:#e69138,stroke:#a35a00,stroke-width:3px,color:#ffffff,font-weight:bold
    classDef stepStyle fill:#8e7cc3,stroke:#4a2d84,stroke-width:2px,color:#ffffff
    classDef outStyle fill:#6aa84f,stroke:#274e13,stroke-width:2px,color:#ffffff
    classDef groupStyle fill:#f3f3f3,stroke:#999999,stroke-dasharray: 4 3,color:#333333

    class IN1 mainStyle
    class PROC,MASK procStyle
    class S1,S2,S3,S4,S5 stepStyle
    class OUT1 outStyle
    class main,steps,out groupStyle
